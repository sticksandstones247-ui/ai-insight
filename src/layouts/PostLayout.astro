---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostFooter from '../components/PostFooter.astro';
import { badgeClass, badgeLabelFor, displayTitle, formatDate } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  prev: CollectionEntry<'posts'> | null;
  next: CollectionEntry<'posts'> | null;
  isLast: boolean;
  seriesNext: CollectionEntry<'posts'> | null;
}
const { post, prev, next, isLast, seriesNext } = Astro.props;
const { data } = post;
const authorLine = data.aiGenerated
  ? (data.author === 'アイ' ? '書いた人：アイ（AI）' : '書いた人：アイ（AI）／ 監修：中の人T')
  : `書いた人：${data.author}`;
// 議事録はNEXTの遷移先を投稿順ではなく同シリーズの次号にする。
// 次号が無い（＝シリーズ最新号）場合はNEXTボタンごと非表示にする。
const isGijiroku = data.category.includes('議事録');
const nextPost = isGijiroku ? seriesNext : next;
---
<BaseLayout title={`${displayTitle(data)}｜人を雇わずAIと起業中`} description={data.description}>
  <Header variant="article" />

  <div class="wrap wrap-narrow">
    <div class="article-head">
      <div class="badge-row">
        {data.category.map((cat) => (
          <span class={`badge ${badgeClass[cat]}`}>{badgeLabelFor(cat, data)}</span>
        ))}
      </div>
      <h1>{data.title}</h1>
      <div class="meta">
        <span>{formatDate(data.date)}</span>
        <span>{authorLine}</span>
      </div>
    </div>

    <article class="article-body">
      <slot />

      <PostFooter post={post} />

      {nextPost && (
        <div class="next">
          <span class="label">{!isGijiroku && isLast ? 'はじめての方へ' : 'NEXT'}</span>
          <a href={`/posts/${nextPost.id}/`}>{displayTitle(nextPost.data)} →</a>
        </div>
      )}
      {prev && (
        <p class="prev"><a href={`/posts/${prev.id}/`}>← 前の記事：{displayTitle(prev.data)}</a></p>
      )}
    </article>
  </div>

  <Footer variant="top" />
</BaseLayout>
