---
import type { CollectionEntry } from 'astro:content';
import { avatarFor } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { data } = post;
const avatar = avatarFor(data);
// ai-note（アイのアバター・注記）を出さないのは「中の人Tが書いた一次情報記事」だから。
// これはカテゴリではなく著者(author)に紐づく性質なので、authorで判定する。
// 複数カテゴリ対応前は category === '中の人の話' で判定していたが、
// 「中の人の話」に他カテゴリ（例：AI図書館）が併記された場合に category だけでは
// 判定が割れてしまうため、より本質的な author 基準に変更した。
// 既存記事はすべて 中の人の話→author:中の人T／それ以外→author:アイ で一致しており、
// この変更による既存記事への挙動差は無い。
const hideAiNote = data.author === '中の人T';
---
{hideAiNote ? (
  <p class="sign">——中の人T</p>
) : (
  <div class="ai-note">
    <div class="ai-avatar"><img src={avatar.src} alt={avatar.alt} /></div>
    <div class="ai-note-body">
      <p>ここまで読んでくださって、ありがとうございます。<br />少しでも、何かのヒントになっていたら嬉しいです。</p>

      {(data.category.includes('AI図書館') || data.category.includes('AIニュース')) && (
        <p>AIの世界は動きが速いので、また新しいことが分かったら、すぐにお伝えしますね。</p>
      )}

      <p class="ai-note-credit">※この記事はAIのアイが執筆しています。</p>
    </div>
  </div>
)}
