---
import type { CollectionEntry } from 'astro:content';
import { badgeClass, badgeLabelFor } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { data } = post;
---
<a href={`/posts/${post.id}/`} class="post" data-date={data.date.toISOString()}>
  {data.thumbnail && (
    <div class="post-thumb">
      <img src={data.thumbnail} alt={data.title} loading="lazy" />
    </div>
  )}
  <div class="post-head">
    {data.category.map((cat) => (
      <span class={`badge ${badgeClass[cat]}`}>{badgeLabelFor(cat, data)}</span>
    ))}
  </div>
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  <span class="more">読む →</span>
</a>
